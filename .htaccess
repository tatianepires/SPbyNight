# BEGIN SP by Night Language Routes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^(en|pt)/?$ index.php?lang=$1 [L,QSA]
</IfModule>
# END SP by Night Language Routes

# BEGIN YOURLS
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ /yourls-loader.php [L]
</IfModule>
# END YOURLS